<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home</title>
</head>
<body>

    <h1>Home</h1>

    <% if (userId) { %>

        <a href="/profile">Profile</a>

        <form action="/logout" method="POST">
            <button type="submit">Log out</button>
        </form>

    <% } else { %>

        <a href="/login">Log in</a>
        <a href="/signup">Sign up</a>

    <% } %>

</body>
</html>